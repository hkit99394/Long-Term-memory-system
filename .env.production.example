# Copy these values into the deployment host's secret source before first use.
# Keep the real .env.production file out of source control.

COMPOSE_PROJECT_NAME=memorysystem-prod
MEMORYSYSTEM_IMAGE=memorysystem:1.0.0
MEMORYSYSTEM_SERVICE_VERSION=1.0.0
MEMORYSYSTEM_SOURCE_REVISION=local
MEMORYSYSTEM_BUILD_DATE=unknown

# local uses the protected Docker volume in docker-compose.production.yml.
# external uses an already-provisioned managed PostgreSQL database and does
# not start the local postgres service.
MEMORYSYSTEM_POSTGRES_PROFILE=local

MEMORYSYSTEM_POSTGRES_DB=memory_system
MEMORYSYSTEM_POSTGRES_USER=memory_system
MEMORYSYSTEM_POSTGRES_PASSWORD=placeholder

# Required only when MEMORYSYSTEM_POSTGRES_PROFILE=external.
# Keep quoted in .env.production because PostgreSQL keywords such as SSL Mode
# contain spaces. Use SSL Mode=VerifyFull when provider CA/DNS validation is
# available; SSL Mode=Require is the minimum managed-profile setting.
MEMORYSYSTEM_POSTGRES_CONNECTION_STRING=
# MEMORYSYSTEM_POSTGRES_CONNECTION_STRING="Host=managed-postgres.example.com;Port=5432;Database=memory_system;Username=memory_system;Password=<secret>;SSL Mode=VerifyFull"

# Optional libpq connection value for platform backup and restore jobs. Prefer
# PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD from the secret store when the job
# runner supports split secret injection.
MEMORYSYSTEM_POSTGRES_URL=

MEMORYSYSTEM_API_BIND=127.0.0.1
MEMORYSYSTEM_API_PORT=8080
MEMORYSYSTEM_ALLOW_UNSAFE_PUBLIC_API_BIND=false

MEMORYSYSTEM_LOCAL_ACCESS_ENABLED=false
MEMORYSYSTEM_LOCAL_ACCESS_BIND=127.0.0.1
MEMORYSYSTEM_LOCAL_ACCESS_PORT=8081
MEMORYSYSTEM_ALLOW_UNSAFE_PUBLIC_LOCAL_ACCESS_BIND=false

MEMORYSYSTEM_PRODUCTION_TLS_ENABLED=false
MEMORYSYSTEM_PUBLIC_HOSTNAME=example.com
MEMORYSYSTEM_TLS_EMAIL=ops@example.com
MEMORYSYSTEM_HTTP_PORT=80
MEMORYSYSTEM_HTTPS_PORT=443

# Set this to the exact CIDR used by the TLS-terminating proxy that forwards
# X-Forwarded-Proto=https to the API container. For many single-host Docker
# bridge installs, use a dedicated narrow Compose subnet or exact proxy /32.
MEMORYSYSTEM_DOCKER_NETWORK_CIDR=172.30.42.0/24
MEMORYSYSTEM_FORWARD_PROXY_NETWORK=172.30.42.0/24
MEMORYSYSTEM_ALLOW_UNSAFE_BROAD_FORWARD_PROXY_NETWORK=false

MEMORYSYSTEM_OPERATOR_API_KEY=placeholder
MEMORYSYSTEM_OPERATOR_PRINCIPAL_ID=replace-with-principal-guid
MEMORYSYSTEM_OPERATOR_DISPLAY_NAME=Production Operator
MEMORYSYSTEM_OPERATOR_CREDENTIAL_ID=

MEMORYSYSTEM_EMBEDDINGS_PROVIDER=openai
MEMORYSYSTEM_EMBEDDINGS_MODEL=text-embedding-3-small
MEMORYSYSTEM_EMBEDDINGS_DIMENSION=1536
MEMORYSYSTEM_EMBEDDINGS_ENDPOINT=https://api.openai.com/v1/embeddings
OPENAI_API_KEY=placeholder

MEMORYSYSTEM_OUTBOX_WORKER_ID=production-docker-worker-1
MEMORYSYSTEM_EPHEMERAL_EVENT_RETENTION_ENABLED=true
