{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "TransportSecurity": {
    "ForwardedHeadersEnabled": false
  },
  "Events": {
    "ExternalPayloadUri": {
      "AllowedSchemes": [],
      "AllowedPrefixes": [],
      "AllowLocalFileUris": false
    }
  },
  "RateLimiting": {
    "Default": {
      "PermitLimit": 600,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Expensive": {
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Mutation": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Admin": {
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "AllowedHosts": "*"
}
