{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memorysystem.local/schemas/target-environment-evidence-manifest.schema.json",
  "title": "MemorySystem Target Environment Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "releaseId",
    "environment",
    "targetEnvironment",
    "imageDigest",
    "databaseTarget",
    "evidencePrefix",
    "generatedAtUtc",
    "payloadSafe",
    "owners",
    "gates"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "memorysystem.target_environment_evidence"
    },
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "targetEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "account",
        "region",
        "networkBoundary"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "account": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "networkBoundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "imageDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "databaseTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "endpointRef",
        "databaseName",
        "pgvectorVerified"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "endpointRef": {
          "type": "string",
          "minLength": 1
        },
        "databaseName": {
          "type": "string",
          "minLength": 1
        },
        "pgvectorVerified": {
          "type": "boolean"
        }
      }
    },
    "evidencePrefix": {
      "type": "string",
      "minLength": 1
    },
    "generatedAtUtc": {
      "type": "string",
      "minLength": 1
    },
    "payloadSafe": {
      "const": true
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseOwner",
        "rollbackOwner",
        "alertRouteOwner",
        "evidenceOwner",
        "benchmarkScorer",
        "governanceReviewer"
      ],
      "properties": {
        "releaseOwner": {
          "type": "string",
          "minLength": 1
        },
        "rollbackOwner": {
          "type": "string",
          "minLength": 1
        },
        "alertRouteOwner": {
          "type": "string",
          "minLength": 1
        },
        "evidenceOwner": {
          "type": "string",
          "minLength": 1
        },
        "benchmarkScorer": {
          "type": "string",
          "minLength": 1
        },
        "governanceReviewer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 11,
      "items": {
        "$ref": "#/$defs/gate"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "id": {
                "const": "environment_preflight"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "terraform_validation"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "deployment_smoke"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "metrics_and_tracing"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "benchmark_scorecards"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "governance_smoke"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "backup_restore"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "alert_receiver_acknowledgement"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "evidence_upload"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "rollback_notes"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "go_no_go"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      ]
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "status",
        "completedAtUtc",
        "summary",
        "artifacts"
      ],
      "properties": {
        "id": {
          "enum": [
            "environment_preflight",
            "terraform_validation",
            "deployment_smoke",
            "metrics_and_tracing",
            "benchmark_scorecards",
            "governance_smoke",
            "backup_restore",
            "alert_receiver_acknowledgement",
            "evidence_upload",
            "rollback_notes",
            "go_no_go"
          ]
        },
        "status": {
          "const": "passed"
        },
        "completedAtUtc": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "description",
        "payloadSafe"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "payloadSafe": {
          "const": true
        }
      }
    }
  }
}
